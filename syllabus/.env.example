# ---- Database (PostgreSQL) ----
# Production + local dev both use Postgres. Get a free DB at https://neon.tech
# (or run `docker compose up -d` if you have Docker), then set:
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/syllabus?sslmode=require"

# ---- Session ----
# Any long random string. Used to sign session JWTs (httpOnly cookie).
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="change-me-to-a-long-random-string-32b+"

# ---- Local plain-HTTP preview of the production build ----
# Session cookies are Secure on HTTPS (correct for Vercel). Only needed if you
# run `next start` locally over plain http:
# SESSION_COOKIE_SECURE="0"

# ---- Dodo Payments ----
# API key from the Dodo dashboard (Developer > API). DODO_ENV=test|live.
# Create 3 ONE-TIME products priced 599 / 1299 / 2399 INR, then set ids below.
# Without keys/products, checkout fails closed with a clear message.
DODO_PAYMENTS_API_KEY=""
DODO_ENV="test"
DODO_PRODUCT_ENROLLED=""
DODO_PRODUCT_HONOR_ROLL=""
DODO_PRODUCT_EXTRA_CREDIT=""
DODO_WEBHOOK_SECRET=""
